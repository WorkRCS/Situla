# Copy to .env and replace every placeholder. Never commit the real .env.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@YOUR_CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=situla

NODE_ENV=development
PORT=3000

# Required for the 500 verified Movie additions seed; use a TMDB API Read Access Token.
# A TMDB v3 API key is accepted as an alternative.
TMDB_API_READ_ACCESS_TOKEN=YOUR_TMDB_API_READ_ACCESS_TOKEN
# TMDB_API_KEY=YOUR_TMDB_V3_API_KEY

# Optional: for migrating legacy TV documents from IMDb IDs to TMDB IDs.
# TMDB_API_KEY=YOUR_TMDB_V3_API_KEY
