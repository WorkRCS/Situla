# Copy to .env and replace every placeholder. Never commit the real .env.
TMDB_API_KEY=replace_with_your_tmdb_api_key
TMDB_API_BASE_URL=https://api.themoviedb.org/3
TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p

MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@YOUR_CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=situla

ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace_with_a_long_unique_password
SESSION_SECRET=replace_with_at_least_32_random_characters
ADMIN_SESSION_TTL_HOURS=8

NODE_ENV=development
PORT=3000
CRAWL_DEFAULT_START_YEAR=2010
CRAWL_DEFAULT_END_YEAR=2026
CRAWL_MAX_PAGES_PER_RUN=5
