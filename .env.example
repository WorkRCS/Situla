# Copy to .env and replace every placeholder. Never commit the real .env.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@YOUR_CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=situla

NODE_ENV=development
PORT=3000

# Movie additions use the public Cinemeta endpoint and do not need an API key.
# Optional: TMDB key is only for the legacy TV identifier migration.
# TMDB_API_KEY=YOUR_TMDB_V3_API_KEY

# Server-side authentication secret (generate a random value of at least 32 bytes).
# Example: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=

# Google OAuth 2.0 Web application credentials.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://YOUR_DOMAIN/api/auth/google/callback


# Optional Upstash Redis (server-side catalog response cache).
# The app continues using MongoDB directly if these values are not configured.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
