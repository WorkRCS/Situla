{
  "name": "situla",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "test": "node --test",
    "migrate:imdb-only": "node scripts/migrate-imdb-only.js",
    "audit:imdb-only": "node scripts/audit-imdb-only.js",
    "seed:tv": "node scripts/seed-catalog.js --tv",
    "migrate:tv-tmdb": "node scripts/migrate-tv-tmdb-ids.js",
    "seed:anime": "node scripts/seed-catalog.js --anime",
    "seed:catalog": "node scripts/seed-catalog.js",
    "seed:movies": "node scripts/seed-catalog.js --movies",
    "check:anime": "node scripts/check-anime-additions.js",
    "audit:anime": "node scripts/audit-anime-artwork.js",
    "audit:anime:apply": "node scripts/audit-anime-artwork.js --apply",
    "check:tv": "node --test test/tv-catalog.test.js",
    "check:movies": "node --test test/movie-catalog.test.js",
    "admin:set-role": "node scripts/set-user-role.js",
    "db:indexes": "node scripts/ensure-database-indexes.js",
    "seed:movie-additions:legacy-online": "node scripts/seed-movie-additions.js",
    "seed:movies:legacy-online": "node scripts/seed-static-catalog.js --movies && npm run seed:movie-additions:legacy-online",
    "seed:tv:legacy-online": "node scripts/seed-static-catalog.js --tv && node scripts/seed-tv-series.js",
    "seed:anime:legacy-curated": "node scripts/seed-anime-additions.js",
    "seed:catalog:legacy-online": "npm run seed:movies:legacy-online && npm run seed:tv:legacy-online && npm run seed:anime:legacy-curated"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.6",
    "dotenv": "^17.2.3",
    "hono": "^4.13.16",
    "mongoose": "^9.0.0",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.1",
    "@headlessui/react": "^2.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.3.1",
    "lucide-react": "^0.468.0",
    "google-auth-library": "^11.3.4",
    "@upstash/redis": "^1.41.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.5",
    "postcss": "^8.5.6",
    "tailwindcss": "4.3.5"
  }
}
